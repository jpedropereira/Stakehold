{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.ci)",
      "Read(**/.env.dev)",
      "Read(**/.env.prod)",
      "Grep(**/.env)",
      "Grep(**/.env.local)",
      "Grep(**/.env.*.local)",
      "Grep(**/.env.development)",
      "Grep(**/.env.staging)",
      "Grep(**/.env.production)",
      "Grep(**/.env.test)",
      "Grep(**/.env.ci)",
      "Grep(**/.env.dev)",
      "Grep(**/.env.prod)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.*.local)",
      "Write(**/.env.development)",
      "Write(**/.env.staging)",
      "Write(**/.env.production)",
      "Write(**/.env.test)",
      "Write(**/.env.ci)",
      "Write(**/.env.dev)",
      "Write(**/.env.prod)",
      "Write(**/.secrets.baseline)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Edit(**/.env.ci)",
      "Edit(**/.env.dev)",
      "Edit(**/.env.prod)",
      "Edit(**/.secrets.baseline)",
      "Read(**/secrets/**)",
      "Edit(**/secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-credential-files.sh\""
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-destructive-commands.sh\""
          }
        ]
      }
    ]
  }
}
