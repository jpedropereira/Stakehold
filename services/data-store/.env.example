# Copy to .env and fill in real values. .env is gitignored.

# --- App Postgres (holdings/prices data) ---
POSTGRES_DB=data_store
POSTGRES_USER=data_store
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# Used by the data-store CLI (settings.py) to connect to the app Postgres above.
DATABASE_URL=postgresql://data_store:change-me@localhost:5433/data_store

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050

# --- Airflow ---
# On Linux, set this to your host UID (`id -u`) so files written into the bind-mounted
# dags/ and logs/ dirs aren't owned by root. Irrelevant on macOS/Windows Docker Desktop.
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.1
AIRFLOW_PORT=8081

AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me

AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# Optional. Encrypts connection passwords stored by Airflow; blank is fine for local dev
# (Airflow will warn and skip encryption). Generate with:
#   docker run --rm apache/airflow:3.3.1 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

AIRFLOW_JWT_SECRET=change-me
