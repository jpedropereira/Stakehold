# Copy to .env and fill in real values. .env is gitignored.

# --- App Postgres (holdings/prices data) ---
POSTGRES_DB=data_store
POSTGRES_USER=data_store
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# Used by the data-store CLI (settings.py) to connect to the app Postgres above.
DATABASE_URL=postgresql://data_store:change-me@localhost:5433/data_store

# --- Macro indicator ingestion ---
# Required by `ingest-macro-indicators`. Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
# Optional for every other command (they never call FRED).
FRED_API_KEY=change-me

# --- Read API ---
# Shared secret the internal caller (portfolio) must send as `Authorization: Bearer <secret>`.
# Optional for the CLI/Airflow (they never call the API), but the API refuses to start without it.
# Deliberately the same, unprefixed, var name as portfolio's own INTERNAL_API_SECRET
# (services/portfolio/.env.example) -- must hold the identical value on both sides.
INTERNAL_API_SECRET=change-me
DATA_STORE_API_PORT=8082
# New tickers one user may add per rolling 24 hours via POST /tracked-tickers. Admins aren't
# limited. Optional; defaults to 10.
DATA_STORE_TICKER_REQUESTS_PER_DAY=10

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050

# --- Airflow ---
# On Linux, set this to your host UID (`id -u`) so files written into the bind-mounted
# dags/ and logs/ dirs aren't owned by root. Irrelevant on macOS/Windows Docker Desktop.
AIRFLOW_UID=50000
# Tag for the locally-built custom image (Dockerfile.airflow: apache/airflow + uv + this
# workspace) — not a pull target. Built automatically on first `docker compose up`; run
# `docker compose build` after changing data_store code to pick it up.
AIRFLOW_IMAGE_NAME=stakehold-data-store-airflow:local
AIRFLOW_PORT=8081

AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me

AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# Optional. Encrypts connection passwords stored by Airflow; blank is fine for local dev
# (Airflow will warn and skip encryption). Generate with:
#   docker run --rm apache/airflow:3.3.1 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

AIRFLOW_JWT_SECRET=change-me
