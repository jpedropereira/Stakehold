# Copy to tracked_tickers.yaml (in this same directory) and edit for your own tickers.
# tracked_tickers.yaml is gitignored, and optional — ingest-ohlcv treats a missing file as
# "no tracked tickers" and still prices every fund's holdings.
#
# Use this for prices you want tracked directly, not derived from any fund's holdings — e.g.
# the ETF itself (not its constituents), commodities, crypto, or a standalone stock. A ticker
# that also appears in a fund's holdings is only fetched once, not once per source — see
# services/data-store/README.md.

tickers:
  - ticker: MY_TICKER               # the yfinance symbol, e.g. IWDA.AS, BTC-USD, GC=F
    display_name: "My Ticker"
    asset_type: etf                 # one of: equity, etf, commodity, crypto, etc
    price_source: yfinance          # which PriceSource implementation prices it
    enabled: true
