# Extends the official Airflow image with `uv` and this repo's workspace, baked in at build
# time, so DAG tasks can shell out to the exact same `data-store` CLI/venv/lockfile already
# verified end-to-end outside Airflow — see README.md for the reasoning.
#
# Rebuild after changing services/data-store/data_store code (docker compose build):
# unlike dags/ (bind-mounted, live), the application code here is a build-time snapshot.
ARG AIRFLOW_BASE_IMAGE=apache/airflow:3.3.1
FROM ${AIRFLOW_BASE_IMAGE}

USER root

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

ENV PLAYWRIGHT_BROWSERS_PATH=/opt/stakehold/.playwright-browsers
# uv's default cache and managed-Python-toolchain locations both depend on $HOME, which
# doesn't resolve consistently for the arbitrary-uid airflow user at task-execution time
# (by default they'd land under /root, built as root, unreadable to airflow at runtime).
# Pin both to paths baked into (and chown'd within) this image.
ENV UV_CACHE_DIR=/opt/stakehold/.uv-cache
ENV UV_PYTHON_INSTALL_DIR=/opt/stakehold/.uv-python

WORKDIR /opt/stakehold

COPY pyproject.toml uv.lock ./
COPY services/data-store services/data-store
COPY services/portfolio services/portfolio

RUN uv sync --frozen \
    && uv run --frozen playwright install --with-deps chromium \
    && chown -R airflow:root /opt/stakehold

USER airflow
