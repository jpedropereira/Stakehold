# Copy to .env and fill in real values. .env is gitignored.

# --- app-postgres (the shared application database) ---
# Separate instance from data-store's and auth's -- see docs/architecture.md's deployment
# reasoning. The database is named for the instance (it is shared); the role is named for the
# service, so a second service on this instance gets its own role in the same database.
APP_POSTGRES_DB=app
APP_POSTGRES_PORT=5435

# The container's bootstrap role, not any service's own -- the official postgres image always
# grants POSTGRES_USER superuser, so this exists only for `db init` to create scoped, non-
# superuser roles with (one per service). Never wired into a running app's own connection.
APP_POSTGRES_ADMIN_USER=app_postgres_admin
APP_POSTGRES_ADMIN_PASSWORD=change-me
APP_POSTGRES_ADMIN_DATABASE_URL=postgresql://${APP_POSTGRES_ADMIN_USER}:${APP_POSTGRES_ADMIN_PASSWORD}@localhost:${APP_POSTGRES_PORT}/${APP_POSTGRES_DB}

# portfolio's own scoped role -- `db init` creates this role and a like-named schema the first
# time it runs (see jobs.py), using the admin credentials above; nothing pre-creates it here.
APP_POSTGRES_USER=portfolio
APP_POSTGRES_PASSWORD=change-me

# Used by the portfolio CLI (settings.py) to connect to app-postgres above. Deliberately not
# named DATABASE_URL -- data-store already owns that name, and the services' integration
# suites can run in one pytest process where a shared name would collide.
# References the vars above rather than repeating the password -- both consumers of this file
# expand ${VAR}: docker compose's env_file loader, and python-dotenv's load_dotenv() (settings.py).
PORTFOLIO_DATABASE_URL=postgresql://${APP_POSTGRES_USER}:${APP_POSTGRES_PASSWORD}@localhost:${APP_POSTGRES_PORT}/${APP_POSTGRES_DB}
