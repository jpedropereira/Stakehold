# Copy to .env and fill in real values. .env is gitignored.

# --- Auth service (task 2) ---
# Base URL web calls server-to-server -- never exposed to browser JS. In docker compose this is
# the in-network auth-api address; from a bare `uv run web serve` on the host it's
# http://localhost:8001 (auth's compose-published port).
WEB_AUTH_API_URL=http://localhost:8001

# Shared-secret bearer token web sends as X-Internal-Secret on every auth call -- must equal
# auth's own AUTH_INTERNAL_SECRET (services/auth/.env.example). See
# docs/architecture.md's "Service-to-service trust" for why this proves "a legitimate internal
# caller" rather than anything about a specific user.
WEB_INTERNAL_SECRET=change-me  # pragma: allowlist secret

# --- Portfolio service (task 9) ---
# Base URL web calls server-to-server -- never exposed to browser JS. In docker compose this is
# the in-network portfolio-api address; from a bare `uv run web serve` on the host it's
# http://localhost:8002 (portfolio's compose-published port).
WEB_PORTFOLIO_API_URL=http://localhost:8002

# Shared-secret bearer token web sends as X-Internal-Secret on every portfolio call -- must equal
# portfolio's own PORTFOLIO_INTERNAL_SECRET (services/portfolio/.env.example). Deliberately a
# separate var from WEB_INTERNAL_SECRET above (auth's own credential), so the two edges rotate
# independently -- the same reasoning portfolio/settings.py documents for its own two secrets.
WEB_PORTFOLIO_INTERNAL_SECRET=change-me  # pragma: allowlist secret

# --- Brand assets ---
# Absolute path to the repo-root brand/ directory, mounted at /brand. Left unset for local
# `uv run web serve` (settings.py defaults to the repo root relative to this package); the
# Docker image sets it explicitly since the brand/ directory is copied to a fixed path there.
# WEB_BRAND_DIR=/opt/stakehold/brand

# --- Cookies ---
# false only for local http (non-TLS) development -- production must run with this true so the
# session-forwarding and CSRF cookies both carry the Secure flag.
WEB_COOKIE_SECURE=true

WEB_API_PORT=8000

# Seconds web waits for a response from auth before treating it as unavailable.
WEB_HTTP_TIMEOUT_SECONDS=10
