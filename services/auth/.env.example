# Copy to .env and fill in real values. .env is gitignored.

# --- Auth Postgres (credentials/sessions) ---
# Dedicated instance, deliberately isolated from data-store's and portfolio's databases --
# see docs/architecture.md's deployment reasoning.
AUTH_POSTGRES_DB=auth
AUTH_POSTGRES_USER=auth
AUTH_POSTGRES_PASSWORD=change-me
AUTH_POSTGRES_PORT=5434

# Used by the auth CLI (settings.py) to connect to the auth Postgres above. Deliberately not
# named DATABASE_URL -- data-store already owns that name, and both services' integration
# suites can run in one pytest process where a shared name would collide.
# References the vars above rather than repeating the password -- both consumers of this file
# expand ${VAR}: docker compose's env_file loader, and python-dotenv's load_dotenv() (settings.py).
AUTH_DATABASE_URL=postgresql://${AUTH_POSTGRES_USER}:${AUTH_POSTGRES_PASSWORD}@localhost:${AUTH_POSTGRES_PORT}/${AUTH_POSTGRES_DB}
